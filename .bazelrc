###############################################################################
## Bazel Configuration Flags
##
## `.bazelrc` is a Bazel configuration file.
## https://bazel.build/docs/best-practices#bazelrc-file
###############################################################################

# https://bazel.build/reference/command-line-reference#flag--enable_platform_specific_config
common --enable_platform_specific_config

# Enable the only currently supported report type
# https://bazel.build/reference/command-line-reference#flag--combined_report
coverage --combined_report=lcov

# Avoid fully cached builds reporting no coverage and failing CI
# https://bazel.build/reference/command-line-reference#flag--experimental_fetch_all_coverage_outputs
coverage --experimental_fetch_all_coverage_outputs

# https://github.com/bazelbuild/bazel/issues/8195
build --incompatible_disallow_empty_glob=true

# https://github.com/bazelbuild/bazel/issues/12821
build --nolegacy_external_runfiles

# Disable legacy __init__.py behavior which is known to conflict with
# modern python versions (3.9+)
build --incompatible_default_to_explicit_init_py

# https://github.com/bazelbuild/bazel/issues/23043.
build --incompatible_autoload_externally=

# Keep undeclared test outputs (benchmark results) as plain files on every
# supported Bazel version. This became the default in Bazel 8.
test --nozip_undeclared_test_outputs

common --java_runtime_version=remotejdk_11

###############################################################################
## Language integrations
##
## Targets under `test/<lang>/` are tagged with their language and with
## `compliance` (conformance tests) or `benchmark`. They are excluded from
## wildcard invocations by default; opt in with a config, e.g.
## `bazel test //... --config=rust`. See README.md.
###############################################################################

build --build_tag_filters=-cc,-go,-java,-python,-rust,-shell
test --test_tag_filters=-cc,-go,-java,-python,-rust,-shell

build:cc --build_tag_filters=cc
test:cc --test_tag_filters=cc

build:go --build_tag_filters=go
test:go --test_tag_filters=go

build:java --build_tag_filters=java
test:java --test_tag_filters=java

build:python --build_tag_filters=python
test:python --test_tag_filters=python

build:rust --build_tag_filters=rust
test:rust --test_tag_filters=rust

build:shell --build_tag_filters=shell
test:shell --test_tag_filters=shell

# All conformance tests, including the reference subject.
build:compliance --build_tag_filters=compliance
test:compliance --test_tag_filters=compliance

# All benchmarks, including the reference subject.
build:benchmark --build_tag_filters=benchmark
test:benchmark --test_tag_filters=benchmark

# Everything.
build:all --build_tag_filters=
test:all --test_tag_filters=

###############################################################################
## Configuration Flags
###############################################################################

# Enable rustfmt for all targets in the workspace
build:rustfmt --aspects=@rules_rust//rust:defs.bzl%rustfmt_aspect
build:rustfmt --output_groups=+rustfmt_checks

# Enable clippy for all targets in the workspace
build:clippy --aspects=@rules_rust//rust:defs.bzl%rust_clippy_aspect
build:clippy --output_groups=+clippy_checks

# Enable black for all targets in the workspace
build:black --aspects=@rules_venv//python/black:defs.bzl%py_black_aspect
build:black --output_groups=+py_black_checks

# Enable isort for all targets in the workspace
build:isort --aspects=@rules_venv//python/isort:defs.bzl%py_isort_aspect
build:isort --output_groups=+py_isort_checks
build --@rules_venv//python/isort:config=//:.isort.cfg

# Enable mypy for all targets in the workspace
build:mypy --aspects=@rules_venv//python/mypy:defs.bzl%py_mypy_aspect
build:mypy --output_groups=+py_mypy_checks
build --@rules_venv//python/mypy:config=//:.mypy.ini

# Enable pylint for all targets in the workspace
build:pylint --aspects=@rules_venv//python/pylint:defs.bzl%py_pylint_aspect
build:pylint --output_groups=+py_pylint_checks
build --@rules_venv//python/pylint:config=//:.pylintrc.toml

# Define a config that enables all linter aspects.
build:strict --config=black
build:strict --config=isort
build:strict --config=pylint
build:strict --config=mypy
build:strict --config=clippy
build:strict --config=rustfmt

test --config=strict

###############################################################################
## Custom user flags
##
## This should always be the last thing in the `.bazelrc` file to ensure
## consistent behavior when setting flags in that file as `.bazelrc` files are
## evaluated top to bottom.
###############################################################################

try-import %workspace%/user.bazelrc
