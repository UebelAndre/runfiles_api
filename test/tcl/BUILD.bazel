load("//:runfiles_conformance_test.bzl", "runfiles_conformance_benchmark", "runfiles_conformance_test")
load("//tools/src_merger:src_merger.bzl", "runfiles_source_file")

# The runfiles library is inlined so the subject is a single file that can be
# launched outside of any runfiles tree.
runfiles_source_file(
    name = "runfiles_user",
    testonly = True,
    src = "runfiles_user_entrypoint.tcl",
    out = "runfiles_user.tcl",
    basename = "runfiles.tcl",
    runfiles = "@rules_tcl//tcl/runfiles",
    tags = ["tcl"],
    template = "# {RUNFILES_LIBRARY}",
)

LAUNCHER = ["$(TCLSH_RLOCATIONPATH)"]

TOOLS = ["//tools/launcher:tcl"]

# `tclsh` needs to find `init.tcl` when started outside its toolchain wrapper.
SUBJECT_ENV = {"TCL_LIBRARY": "$(TCL_LIBRARY_RLOCATIONPATH)"}

runfiles_conformance_test(
    name = "test_runfiles",
    binary = ":runfiles_user",
    lang = "tcl",
    launcher = LAUNCHER,
    subject_env = SUBJECT_ENV,
    tools = TOOLS,
)

runfiles_conformance_benchmark(
    name = "bench_runfiles",
    binary = ":runfiles_user",
    lang = "tcl",
    launcher = LAUNCHER,
    subject_env = SUBJECT_ENV,
    tools = TOOLS,
)
