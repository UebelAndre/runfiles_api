load("//:runfiles_conformance_test.bzl", "runfiles_conformance_benchmark", "runfiles_conformance_test")
load("//tools/src_merger:src_merger.bzl", "runfiles_source_file")

# The runfiles module is inlined so the subject is a single file that can be
# launched outside of any runfiles tree.
runfiles_source_file(
    name = "runfiles_user",
    testonly = True,
    src = "runfiles_user_entrypoint.ps1",
    out = "runfiles_user.ps1",
    basename = "Runfiles.psm1",
    runfiles = "@rules_powershell//powershell/runfiles",
    tags = ["powershell"],
    template = "# {RUNFILES_LIBRARY}",
)

LAUNCHER = [
    "$(PWSH_RLOCATIONPATH)",
    "-NoProfile",
    "-NonInteractive",
    "-File",
]

TOOLS = ["@rules_powershell//powershell:current_pwsh_toolchain"]

runfiles_conformance_test(
    name = "test_runfiles",
    binary = ":runfiles_user",
    lang = "powershell",
    launcher = LAUNCHER,
    tools = TOOLS,
)

runfiles_conformance_benchmark(
    name = "bench_runfiles",
    binary = ":runfiles_user",
    lang = "powershell",
    launcher = LAUNCHER,
    tools = TOOLS,
)
