load("@rules_java//java:java_binary.bzl", "java_binary")
load("//:runfiles_api_test.bzl", "runfiles_api_benchmark", "runfiles_api_test")

java_binary(
    name = "runfiles_user",
    testonly = True,
    srcs = ["RunfilesUser.java"],
    main_class = "com.runfiles_api.test.RunfilesUser",
    tags = ["java"],
    deps = ["@rules_java//java/runfiles"],
)

LAUNCHER = [
    "$(JAVA_RLOCATIONPATH)",
    "-jar",
]

TOOLS = ["//tools/launcher:java"]

# The `java_binary` launcher stub locates its jar through its own runfiles and
# cannot run once copied out of the tree, so the self-contained deploy jar is
# the subject and the JDK from the Java toolchain is the launcher.
runfiles_api_test(
    name = "test_runfiles",
    binary = ":runfiles_user_deploy.jar",
    lang = "java",
    launcher = LAUNCHER,
    tools = TOOLS,
)

runfiles_api_benchmark(
    name = "bench_runfiles",
    binary = ":runfiles_user_deploy.jar",
    lang = "java",
    launcher = LAUNCHER,
    tools = TOOLS,
)
