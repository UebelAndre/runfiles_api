load("@rules_venv//python:py_library.bzl", "py_library")
load("//:runfiles_conformance_test.bzl", "runfiles_conformance_benchmark", "runfiles_conformance_test")

# The subject is launched as a plain file; this target exists so the linters
# cover it like the rest of the harness.
py_library(
    name = "reference",
    testonly = True,
    srcs = ["runfiles_user.py"],
)

LAUNCHER = [
    "$(PYTHON_RLOCATIONPATH)",
    "-I",
]

TOOLS = ["//tools/launcher:python"]

runfiles_conformance_test(
    name = "test_runfiles",
    binary = "runfiles_user.py",
    lang = "reference",
    launcher = LAUNCHER,
    tools = TOOLS,
)

runfiles_conformance_benchmark(
    name = "bench_runfiles",
    binary = "runfiles_user.py",
    lang = "reference",
    launcher = LAUNCHER,
    tools = TOOLS,
)
