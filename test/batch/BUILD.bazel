load("//:runfiles_conformance_test.bzl", "runfiles_conformance_benchmark", "runfiles_conformance_test")
load("//tools/src_merger:src_merger.bzl", "runfiles_source_file")

# The runfiles library is appended in its documented inline mode so the
# subject is a single file that can be launched outside of any runfiles tree.
runfiles_source_file(
    name = "runfiles_user",
    testonly = True,
    src = "runfiles_user_entrypoint.bat",
    out = "runfiles_user.bat",
    basename = "runfiles.bat",
    runfiles = "@rules_batch//batch/runfiles:runfiles.bat",
    tags = ["batch"],
    template = "@REM {RUNFILES_LIBRARY}",
)

# `.bat` files are launched directly; Windows starts `cmd.exe` for them.
runfiles_conformance_test(
    name = "test_runfiles",
    binary = ":runfiles_user",
    lang = "batch",
    target_compatible_with = ["@platforms//os:windows"],
)

# The subject reports benchmarking as unsupported; the target exists so every
# language has the same pair.
runfiles_conformance_benchmark(
    name = "bench_runfiles",
    binary = ":runfiles_user",
    lang = "batch",
    target_compatible_with = ["@platforms//os:windows"],
)
