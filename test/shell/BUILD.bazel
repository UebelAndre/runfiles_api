load("//:runfiles_conformance_test.bzl", "runfiles_conformance_benchmark", "runfiles_conformance_test")
load("//tools/src_merger:src_merger.bzl", "runfiles_source_file")

# The runfiles library is inlined, which is also how Bazel documents its use.
runfiles_source_file(
    name = "runfiles_user",
    testonly = True,
    src = "runfiles_user_entrypoint.sh",
    out = "runfiles_user.sh",
    runfiles = "@rules_shell//shell/runfiles",
    tags = ["shell"],
    template = "# {RUNFILES_CONFORMANCE}",
)

LAUNCHER = ["$(BASH_PATH)"]

TOOLS = ["//tools/launcher:shell"]

runfiles_conformance_test(
    name = "test_runfiles",
    binary = ":runfiles_user",
    lang = "shell",
    launcher = LAUNCHER,
    tools = TOOLS,
)

# Every manifest lookup forks `grep` (several for a miss), so far fewer
# iterations are needed to keep the run short.
runfiles_conformance_benchmark(
    name = "bench_runfiles",
    binary = ":runfiles_user",
    iterations = 10,
    lang = "shell",
    launcher = LAUNCHER,
    tools = TOOLS,
)
