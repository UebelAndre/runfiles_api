load("//:runfiles_api_test.bzl", "runfiles_api_benchmark", "runfiles_api_test")
load("//tools/src_merger:src_merger.bzl", "runfiles_source_file")

# The runfiles library is inlined so the subject is a single file that can be
# launched outside of any runfiles tree.
runfiles_source_file(
    name = "runfiles_user",
    testonly = True,
    src = "runfiles_user_entrypoint.py",
    out = "runfiles_user.py",
    runfiles = "@rules_python//python/runfiles",
    tags = ["python"],
    template = "from python.runfiles import Runfiles",
)

LAUNCHER = [
    "$(PYTHON_RLOCATIONPATH)",
    "-I",
]

TOOLS = ["//tools/launcher:python"]

runfiles_api_test(
    name = "test_runfiles",
    binary = ":runfiles_user",
    lang = "python",
    launcher = LAUNCHER,
    tools = TOOLS,
)

runfiles_api_benchmark(
    name = "bench_runfiles",
    binary = ":runfiles_user",
    lang = "python",
    launcher = LAUNCHER,
    tools = TOOLS,
)
